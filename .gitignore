# Reproducible Cargo output and local distribution drafts
/target/
/app/target/
/dist/
/release-staging/
/.cargo/config.toml

# Optional local data must stay outside the repository; guard accidental copies.
/local/
/roms/
/saves/
/resources/
/references/
/app/roms/
/app/saves/
**/rom-library/
*.rhl
*.rhl.bak
*.rhstate
*.rhstate.bak
*.rhstate.*.tmp
settings.rhc
settings.rhc.bak
.settings.rhc.*.tmp
.settings.rhc.bak.*.tmp

# Generated binaries, diagnostics and user media
*.exe
*.pdb
*.dll
*.lib
*.rom
*.bin
*.dump
*.dmp
*.log
*.csv
*.trace
*.wav
*.zip
*.7z
*.mp4
**/Screenshots/
**/Recordings/
**/screenshots/
!/docs/screenshots/
/docs/screenshots/*
!/docs/screenshots/README.md
!/docs/screenshots/*.png
!/docs/screenshots/*.jpg
!/docs/screenshots/*.jpeg
!/docs/screenshots/*.webp
!/docs/screenshots/*.gif

# Secrets, private agent settings, caches and editor state
.env
.env.*
!.env.example
*.pem
*.key
__pycache__/
*.py[cod]
/.codex/
/.agents/
/.aws/
/.ssh/
/.vs/
/.idea/
*.code-workspace
/.vscode/*.local.json

# Optional private LCD coverage and nonvolatile images
*.rhlcd
